PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://univ:univ_dev_password@localhost:5432/univ_platform

# Sign this with a long random string in every real environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Used only by `npm run db:seed` to create/update the first admin account.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@univ-platform.test
ADMIN_PASSWORD=change-me-too

# From Google Cloud Console > APIs & Services > Credentials. Must match the
# same value the client uses (client/.env's VITE_GOOGLE_CLIENT_ID) — the
# backend checks a Google ID token's audience against this.
GOOGLE_CLIENT_ID=
