# Copy to server/.env ON THE DROPLET and fill in every blank. Never commit the real file.
# IMPORTANT: create this file BEFORE running `npm ci` — the install runs
# `prisma generate`, which refuses to start if DATABASE_URL is missing.

NODE_ENV=production
PORT=5000

# What people type into the browser — no trailing slash.
CLIENT_ORIGIN=https://YOUR_DOMAIN

# The Postgres role and database you create on the droplet (see the runbook).
# Use letters and digits only in the password, or URL-encode any symbols.
# Generate one with:  openssl rand -hex 24
DATABASE_URL=postgresql://univ_app:CHANGE_ME@localhost:5432/univ_platform

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must differ from your laptop's secret. Anyone holding it can forge a login.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The first admin, created once by `npm run db:seed`. Choose a real password —
# NOT the one from your laptop's .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Same value as VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=

# NEVER run `npm run db:seed:demo` on this server. It creates 650 accounts that
# all share the password demo12345 — fine on your laptop, a hole on the internet.
